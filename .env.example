# Продакшн-домен (без слеша в кінці) — впливає на canonical, sitemap.xml, robots.txt
NEXT_PUBLIC_SITE_URL=https://example.com

# Telegram-сповіщення майстру про нову заявку (необов'язкові:
# без них заявка все одно приймається, лише не надсилається в Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Clerk — вхід у кабінет. Локально підтягуються командою `clerk env pull`,
# у Vercel задані напряму (Marketplace-інтеграцію знято).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Адмінка /admin — власний вхід майстра, окремо від Clerk.
# ADMIN_SESSION_SECRET: згенерувати `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Імʼя для привітання в адмінці (без нього показується частина пошти до «@»)
ADMIN_NAME=

# Другий майстер — необовʼязково. Якщо порожньо, працює один акаунт.
ADMIN_EMAIL_2=
ADMIN_PASSWORD_2=
ADMIN_NAME_2=

ADMIN_SESSION_SECRET=
